# Copy this file to .env and fill in the values locally / on the server.

# --- API keys (required for live analysis) -------------------------------
OPENAI_API_KEY=

# Recommended for this project because it is finance-specific and returns
# entity metadata plus sentiment.
MARKETAUX_API_TOKEN=

# Optional alternative provider
ALPHA_VANTAGE_API_KEY=

# --- Deployment (Docker, behind host nginx) ------------------------------
# Host loopback port the container is published on. Your global nginx
# reverse-proxies the subdomain to 127.0.0.1:APP_PORT.
APP_PORT=8080

# Server bind settings inside the container (usually leave as-is).
HOST=0.0.0.0
PORT=8080

# --- Public-demo cost protection -----------------------------------------
# Each /api/research call triggers paid OpenAI + news API requests, so the
# public endpoint is rate limited. Set any value to 0 to disable that limit.
# Max analyses per visitor IP within the window below.
RATE_LIMIT_PER_IP=8
# Sliding window length in seconds (3600 = 1 hour).
RATE_LIMIT_WINDOW_SECONDS=3600
# Global safety cap across all visitors per UTC day (protects your bill).
RATE_LIMIT_GLOBAL_PER_DAY=150
